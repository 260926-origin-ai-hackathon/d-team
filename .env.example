# コピーして .env にすると読み込まれます（無くても動きます）
# 使うモデル（ollama pull 済みのもの）
LOCALAI_MODEL=qwen3.5:4b
# Ollama サーバーの URL（通常はこのまま）
OLLAMA_HOST=http://localhost:11434
# 既定のシステムプロンプト
LOCALAI_SYSTEM_PROMPT=あなたは日本語で簡潔に答えるビジネスアシスタントです。

# ---- 避難所AI（shelter/）----
SHELTER_NAME=東高等学校 避難所
SHELTER_ADDRESS=大阪市都島区東野田町4-15-14
# Windows モバイルホットスポットの既定 IP（違うときは ipconfig で確認）
SHELTER_HOST_IP=192.168.137.1
SHELTER_PORT=8000
SHELTER_SSID=HINANJO-AI
SHELTER_WIFI_PASSWORD=
# 想定地区の町名（カンマ区切り。ダッシュボードの「想定地区の住民 %」。画面の設定が優先）
SHELTER_AREA_TOWNS=東野田町,Higashinoda
# 運営者画面の共通 PIN
SHELTER_STAFF_PIN=1234
# Cookie 署名鍵（空なら起動ごとに生成＝再起動で再ログイン）
SHELTER_SECRET_KEY=
# 埋め込みモデル（軽くするなら embeddinggemma）
SHELTER_EMBED_MODEL=bge-m3
# チャットモデル（空なら LOCALAI_MODEL）。GPU 無しのノートPCでは qwen3:1.7b が既定
# （qwen3.5 系は質問が変わるたびに前置きを全部読み直し、CPU だと1問に数分かかった。
#   GPU のある PC なら qwen3.5:4b でもよい。変えたら ollama pull <モデル名>）
SHELTER_CHAT_MODEL=qwen3:1.7b
# クラウド AI（Gemini）。キーを書いたときだけ、チャットと AI助手の右上に切り替えスイッチが出る
# 要配慮者の洗い出し（名簿）は常にこの PC の AI。埋め込み（マニュアル検索）も Ollama のまま
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# 思考トークン（0 = 使わない。短い回答枠を思考で使い切らないため）
GEMINI_THINKING_BUDGET=0
# 本部同期: file | http | supabase
SYNC_TRANSPORT=file
SYNC_URL=
SYNC_TOKEN=
